# Copy to .env and fill in. .env is gitignored (never commit real keys).
# Free Census API key: https://api.census.gov/data/key_signup.html
CAM_CENSUS_API_KEY=

# Iteris "511" camera APIs: one free key per state (create a site account, then
# request a key on the site's /developers/doc page). Blank = skip that state.
# Used only by the backend / bake, never shipped to the browser.
#   GA 511ga.org | WI 511wi.gov | NV www.nvroads.com | NC www.drivenc.gov
#   UT www.udottraffic.utah.gov | AK 511.alaska.gov | LA www.511la.org
#   ID 511.idaho.gov | AZ az511.com
CAM_ITERIS_KEY_GA=
CAM_ITERIS_KEY_WI=
CAM_ITERIS_KEY_NV=
CAM_ITERIS_KEY_NC=
CAM_ITERIS_KEY_UT=
CAM_ITERIS_KEY_AK=
CAM_ITERIS_KEY_LA=
CAM_ITERIS_KEY_ID=
CAM_ITERIS_KEY_AZ=

# OHGO (Ohio DOT) public API key: free sign-up at https://publicapi.ohgo.com/
# Sent as an Authorization header. Blank = skip Ohio.
CAM_OHGO_API_KEY=
